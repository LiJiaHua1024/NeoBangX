# NeoBangX 后端环境变量配置
# 复制本文件为 .env 并填入真实值

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8001

# 路径（可选；默认值即如下相对路径，本地开发通常无需填写）
# ⚠️ Docker 部署时这些值会经 env_file 进入容器并覆盖镜像内的绝对路径，
#    导致前端/Prompt 丢失——compose 已用 environment 显式钉死容器路径，请勿改动
PROMPTS_DIR=../prompts
STATIC_DIR=../frontend
ADMIN_STATIC_DIR=../admin-frontend
DATA_DIR=./data

# JWT
# 必改！保留默认值时管理后台会显示安全警告：知道该值的人可离线伪造登录票据。
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=neobangx-dev-secret-change-me
JWT_EXPIRE_DAYS=365

# 兼容旧版：OpenRouter API Key（未配置 LLM_API_KEY 时使用）
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 模型配置（LiteLLM 格式）
DEFAULT_MODEL=openrouter/google/gemini-2.0-flash
MODELS=openrouter/google/gemini-2.0-flash,openrouter/anthropic/claude-3.5-sonnet,openrouter/deepseek/deepseek-chat

# 主 AI 连接配置（可被前端请求覆盖；留空则使用上方兼容配置）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Chores AI 连接配置：用于标题生成等轻量任务
# 留空则回退到主 AI 配置
CHORES_MODEL=
CHORES_BASE_URL=
CHORES_API_KEY=

# LLM 调用参数
# 2026 年主流模型 temperature/top_p 保持默认即可获得最佳性能，不再暴露配置
MAX_TOKENS=4096
TIMEOUT=120

# SSE 重试时间（毫秒）
SSE_RETRY_TIMEOUT=30000

# 使用日志
# 是否记录每次请求的原始输入 / 渲染 Prompt / 模型输出（元数据始终记录）。
# 也可在管理后台「API 配置 → 日志设置」中随时切换。
LOG_PAYLOAD=false
# 日志保留天数：超过后自动清理（含原始数据）；0 = 永久保留
LOG_RETENTION_DAYS=0
